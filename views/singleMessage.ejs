<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Single Message</title>
    <link rel="stylesheet" href="/css/message.css">
  </head>
  <body>
    <header>
      <div class="title">Single Message</div>
      <div>
        <a class="btnLink" href="/new"><button>Add New Message</button></a>
        <a href="/"><button>See All Messages</button></a>
      </div>
    </header>

    <main>
      <div><%= text %></div>
      <div>
        <div><%= username %></div>
        <div><%= added %></div>
      </div>
      <form method="POST" action="/message/<%= index %>">
        <button type="submit">Delete</button>
      </form>
    </main>

    <footer></footer>
  </body>
</html>